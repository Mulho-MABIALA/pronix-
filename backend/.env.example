# ─── Base de données ───────────────────────────────────────────────────────────
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/statistique_foot"

# ─── JWT ───────────────────────────────────────────────────────────────────────
JWT_ACCESS_SECRET="votre_secret_access_jwt_tres_long_et_aleatoire"
JWT_REFRESH_SECRET="votre_secret_refresh_jwt_tres_long_et_aleatoire"
JWT_ACCESS_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="30d"

# ─── Serveur ───────────────────────────────────────────────────────────────────
PORT=5000
NODE_ENV="development"
FRONTEND_URL="http://localhost:3000"

# ─── API Football (API-Football via RapidAPI) ──────────────────────────────────
FOOTBALL_API_KEY="votre_cle_api_rapidapi"
FOOTBALL_API_HOST="api-football-v1.p.rapidapi.com"
FOOTBALL_API_BASE_URL="https://api-football-v1.p.rapidapi.com/v3"
# Marchés corners live — coûte 1 requête API par match LIVE toutes les 2 min.
# Ne passer à "true" qu'après avoir upgradé le plan API (quota > 100/jour).
LIVE_CORNERS_POLLING="false"

# ─── Wave (paiement mobile Sénégal) ───────────────────────────────────────────
WAVE_API_KEY="votre_cle_api_wave"
WAVE_BASE_URL="https://api.wave.com/v1"
WAVE_WEBHOOK_SECRET="votre_secret_webhook_wave"

# ─── PayTech (carte bancaire internationale + Mobile Money Sénégal/CI/Mali/Bénin) ─
# Créer un compte sur https://paytech.sn, récupérer les clés dans Dashboard >
# Paramètres > API. Compte e-commerce gratuit. Mode "test" par défaut tant que
# le compte n'est pas activé en production (email à contact@paytech.sn).
PAYTECH_API_KEY="votre_cle_api_paytech"
PAYTECH_API_SECRET="votre_cle_secrete_paytech"
PAYTECH_BASE_URL="https://paytech.sn/api"
PAYTECH_ENV="test"

# ─── Email (Nodemailer / SMTP) ─────────────────────────────────────────────────
SMTP_HOST="smtp.gmail.com"
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER="votre_email@gmail.com"
SMTP_PASS="votre_mot_de_passe_application"
EMAIL_FROM="Fpronix <noreply@fpronix.com>"

# ─── Notifications SMS/WhatsApp (optionnel — ex. Twilio) ──────────────────────
TWILIO_ACCOUNT_SID="votre_account_sid"
TWILIO_AUTH_TOKEN="votre_auth_token"
TWILIO_PHONE_NUMBER="+12345678901"

# ─── Application ──────────────────────────────────────────────────────────────
APP_NAME="Fpronix"
APP_URL="https://fpronix.com"
BCRYPT_ROUNDS=12

# ─── Sentry (suivi d'erreurs production) ───────────────────────────────────────
# Créer un compte gratuit sur https://sentry.io (jusqu'à 5k erreurs/mois),
# créer un projet Node.js, copier le DSN fourni. Laisser vide = désactivé.
SENTRY_DSN=""

# ─── GeniusPay (Mobile Money — Wave/Orange/Airtel/MTN, moyen par défaut FCFA) ──
GENIUSPAY_API_KEY=""
GENIUSPAY_API_SECRET=""
GENIUSPAY_WEBHOOK_SECRET=""
GENIUSPAY_BASE_URL="https://geniuspay.ci/api/v1/merchant"

# ─── Flutterwave (carte internationale Visa/Mastercard + devises étrangères) ───
# Créer un compte sur https://dashboard.flutterwave.com, récupérer les clés
# Test (FLWPUBK_TEST-.../FLWSECK_TEST-...) dans Settings > API Keys. Le hash de
# webhook est une chaîne que VOUS définissez dans Settings > Webhooks (pas
# auto-générée) — la même valeur doit être renseignée ici.
FLUTTERWAVE_PUBLIC_KEY=""
FLUTTERWAVE_SECRET_KEY=""
FLUTTERWAVE_WEBHOOK_HASH=""
FLUTTERWAVE_BASE_URL="https://api.flutterwave.com/v3"
