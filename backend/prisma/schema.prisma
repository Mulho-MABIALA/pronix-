// Prisma Schema — Statistique Foot
// Base : PostgreSQL (JSON natif, full-text search, meilleur pour analytics)

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── ENUMS ─────────────────────────────────────────────────────────────────────

enum Role {
  USER
  ADMIN
}

enum SubStatus {
  ACTIVE
  EXPIRED
  CANCELLED
}

enum BillingCycle {
  WEEKLY
  MONTHLY
  YEARLY
}

enum PaymentMethod {
  WAVE
  CARD
  MOBILE_MONEY
}

enum PaymentStatus {
  PENDING
  COMPLETED
  FAILED
  REFUNDED
}

enum MatchStatus {
  SCHEDULED
  LIVE
  FINISHED
  POSTPONED
  CANCELLED
}

enum TipPrediction {
  HOME_WIN
  DRAW
  AWAY_WIN
  OVER_2_5
  UNDER_2_5
  BTTS_YES
  BTTS_NO
}

enum TipResult {
  WIN
  LOSS
  VOID
}

enum ReportStatus {
  PENDING
  REVIEWED
  DISMISSED
  ACTIONED
}

// ─── UTILISATEURS ──────────────────────────────────────────────────────────────

model User {
  id            String   @id @default(uuid())
  email         String   @unique
  password      String?
  username      String   @unique
  googleId      String?  @unique
  role          Role     @default(USER)
  isActive      Boolean  @default(true)
  emailVerified Boolean  @default(false)
  referralCode  String?  @unique
  referredById  String?
  adminNote     String?  @db.Text
  lastLoginAt   DateTime?
  appInstalledAt DateTime?
  trialEndsAt   DateTime?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  profile            Profile?
  subscription       Subscription?
  payments           Payment[]
  tips               Tip[]
  tipsterStats       TipsterStats?
  favorites          Favorite[]
  reports            Report[]           @relation("Reporter")
  refreshTokens      RefreshToken[]
  passwordResets     PasswordReset[]
  pushSubscriptions  PushSubscription[]
  chatQuotas         ChatQuota[]
  ticketQuotas       TicketQuota[]
  emailVerifications EmailVerification[]
  referralsGiven     Referral[]         @relation("ReferrerUser")
  referralReceived   Referral?          @relation("RefereeUser")
  partnerConversion  PartnerConversion?
  betEntries           BetEntry[]
  matchReminders       MatchReminder[]
  blogPosts            BlogPost[]            @relation("BlogAuthor")
  tipsterPlan          TipsterPlan?          @relation("TipsterPlan")
  tipsterSubscriptions TipsterSubscription[] @relation("TipsterSubscriber")
  combos               TipCombo[]            @relation("UserCombos")
  following            TipsterFollow[]       @relation("FollowerUser")
  followers            TipsterFollow[]       @relation("FollowedUser")
  tipComments          TipComment[]          @relation("TipCommentAuthor")
  virtualWallet        VirtualWallet?
  oddsAlerts           OddsAlert[]
  weeklyStats          TipsterWeeklyStats[]
  supportTickets       SupportTicket[]

  @@map("users")
}

model Profile {
  id              String   @id @default(uuid())
  userId          String   @unique
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  displayName     String?
  bio             String?
  avatar          String?
  favoriteTeams   String[] @default([])
  favoriteLeagues String[] @default([])
  notifEmail      Boolean  @default(true)
  notifSms        Boolean  @default(false)
  onboardingDone  Boolean  @default(false)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@map("profiles")
}

model RefreshToken {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  token     String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
  @@map("refresh_tokens")
}

model PasswordReset {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  token     String   @unique
  expiresAt DateTime
  used      Boolean  @default(false)
  createdAt DateTime @default(now())

  @@map("password_resets")
}

model EmailVerification {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  token     String   @unique
  expiresAt DateTime
  used      Boolean  @default(false)
  createdAt DateTime @default(now())

  @@map("email_verifications")
}

model Referral {
  id          String    @id @default(uuid())
  referrerId  String
  referrer    User      @relation("ReferrerUser", fields: [referrerId], references: [id])
  refereeId   String    @unique
  referee     User      @relation("RefereeUser", fields: [refereeId], references: [id])
  status      String    @default("PENDING") // PENDING | REWARDED
  rewardedAt  DateTime?
  createdAt   DateTime  @default(now())

  @@map("referrals")
}

// ─── PROGRAMME PARTENAIRES (INFLUENCEURS) ──────────────────────────────────────
// Partenariat à la performance : un influenceur reçoit un code unique et touche
// un pourcentage (commissionRate) sur chaque abonnement payé par une personne
// venue via ce code. Distinct du parrainage classique (Referral) qui récompense
// en jours Premium plutôt qu'en argent — ici la commission est calculée en FCFA
// à chaque paiement réel et payée manuellement (Mobile Money) par l'admin.
model Partner {
  id             String    @id @default(uuid())
  name           String
  code           String    @unique
  commissionRate Float     // ex: 0.30 = 30% du montant du paiement
  contact        String?   // WhatsApp / téléphone, pour le versement de la commission
  active         Boolean   @default(true)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  conversions PartnerConversion[]

  @@map("partners")
}

model PartnerConversion {
  id        String   @id @default(uuid())
  partnerId String
  partner   Partner  @relation(fields: [partnerId], references: [id], onDelete: Cascade)
  userId    String   @unique
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  commissions PartnerCommission[]

  @@index([partnerId])
  @@map("partner_conversions")
}

model PartnerCommission {
  id               String    @id @default(uuid())
  conversionId     String
  conversion       PartnerConversion @relation(fields: [conversionId], references: [id], onDelete: Cascade)
  paymentId        String    @unique
  payment          Payment   @relation(fields: [paymentId], references: [id], onDelete: Cascade)
  amount           Int       // montant du paiement, en FCFA
  commissionAmount Float     // montant × commissionRate au moment du paiement
  status           String    @default("PENDING") // PENDING | PAID
  paidAt           DateTime?
  createdAt        DateTime  @default(now())

  @@index([conversionId])
  @@map("partner_commissions")
}

// ─── ABONNEMENTS & PAIEMENTS ───────────────────────────────────────────────────

model Plan {
  id           String   @id @default(uuid())
  code         String   @unique // FREE, PREMIUM, PRO
  displayName  String
  priceWeekly  Int      @default(0) // en FCFA — 0 tant que non configuré (plan existant)
  priceMonthly Int      // en FCFA (0 pour FREE)
  priceYearly  Int      // en FCFA
  features     Json     // tableau de chaînes décrivant les fonctionnalités
  isActive     Boolean  @default(true)
  sortOrder    Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  subscriptions Subscription[]

  @@map("plans")
}

model Subscription {
  id           String       @id @default(uuid())
  userId       String       @unique
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  planId       String
  plan         Plan         @relation(fields: [planId], references: [id])
  status       SubStatus    @default(ACTIVE)
  billingCycle BillingCycle @default(MONTHLY)
  startDate    DateTime     @default(now())
  endDate      DateTime?    // null pour FREE (sans expiration)
  autoRenew    Boolean      @default(false)
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  payments Payment[]

  @@index([status, endDate])
  @@map("subscriptions")
}

model Payment {
  id             String        @id @default(uuid())
  userId         String
  user           User          @relation(fields: [userId], references: [id])
  subscriptionId String?
  subscription   Subscription? @relation(fields: [subscriptionId], references: [id])
  amount         Int           // en FCFA
  currency       String        @default("XOF")
  method         PaymentMethod
  status         PaymentStatus @default(PENDING)
  provider       String        // "wave" | "cinetpay"
  providerRef    String?       // ID de transaction chez le provider
  transactionId  String?       @unique
  metadata       Json?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  partnerCommission PartnerCommission?

  @@index([userId])
  @@index([status])
  @@map("payments")
}

// ─── MATCHS & COMPÉTITIONS ────────────────────────────────────────────────────

model Competition {
  id          String   @id @default(uuid())
  externalId  String   @unique
  name        String
  country     String
  logo        String?
  isDisplayed Boolean  @default(true)
  season      String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  matches Match[]

  @@map("competitions")
}

model Match {
  id            String      @id @default(uuid())
  externalId    String      @unique
  competitionId String
  competition   Competition @relation(fields: [competitionId], references: [id])
  homeTeam      String
  homeTeamId    String
  homeTeamLogo  String?
  awayTeam      String
  awayTeamId    String
  awayTeamLogo  String?
  homeScore     Int?
  awayScore     Int?
  status        MatchStatus @default(SCHEDULED)
  minute        String?     // ex: "67'", "HT", "45+2'" — null si non commencé
  scheduledAt   DateTime
  venue         String?
  round         String?
  // Données premium (compositions, stats avancées)
  lineups       Json?
  statistics    Json?
  predictions   Json?
  headToHead    Json?
  injuries      Json?
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  tips           Tip[]
  betEntries     BetEntry[]
  matchReminders MatchReminder[]
  comboEntries   TipComboEntry[]
  virtualBets    VirtualBet[]

  @@index([scheduledAt])
  @@index([status])
  @@index([competitionId])
  @@map("matches")
}

// ─── TIPSTERS & PRONOSTICS ────────────────────────────────────────────────────

model Tip {
  id         String        @id @default(uuid())
  userId     String
  user       User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  matchId    String
  match      Match         @relation(fields: [matchId], references: [id])
  prediction    TipPrediction
  confidence    Int?          // 1 à 5 étoiles
  analysis      String?       // texte d'analyse (max 500 chars)
  result        TipResult?    // calculé automatiquement après le match
  isVisible     Boolean       @default(true)
  isAiGenerated Boolean       @default(false)
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  reports  Report[]
  comments TipComment[]

  @@unique([userId, matchId]) // un seul pronostic par match par tipster
  @@index([userId])
  @@index([matchId])
  @@map("tips")
}

model TipsterStats {
  id             String   @id @default(uuid())
  userId         String   @unique
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  totalTips      Int      @default(0)
  correctTips    Int      @default(0)
  successRate    Float    @default(0) // pourcentage 0-100
  monthlyTips    Int      @default(0)
  monthlyCorrect Int      @default(0)
  monthlyRate    Float    @default(0)
  monthlyRank    Int?
  globalRank     Int?
  badges         String[] @default([])
  lastCalculated DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@map("tipster_stats")
}

model Report {
  id         String       @id @default(uuid())
  reporterId String
  reporter   User         @relation("Reporter", fields: [reporterId], references: [id])
  tipId      String
  tip        Tip          @relation(fields: [tipId], references: [id])
  reason     String
  status     ReportStatus @default(PENDING)
  adminNote  String?
  createdAt  DateTime     @default(now())
  updatedAt  DateTime     @updatedAt

  @@map("reports")
}

model Favorite {
  id         String   @id @default(uuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  type       String   // "team" | "league" | "tipster"
  externalId String   // ID externe ou userId pour tipster
  name       String
  logo       String?
  createdAt  DateTime @default(now())

  @@unique([userId, type, externalId])
  @@map("favorites")
}

// ─── QUOTAS CHAT IA ──────────────────────────────────────────────────────────

model ChatQuota {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  date      String   // format YYYY-MM-DD
  count     Int      @default(0)
  updatedAt DateTime @updatedAt

  @@unique([userId, date])
  @@map("chat_quotas")
}

// ─── QUOTA GÉNÉRATEUR DE TICKETS ────────────────────────────────────────────
// Même principe que ChatQuota : 3 générations/jour pour les comptes gratuits,
// illimité pour PREMIUM/PRO/LIFETIME (et pendant l'essai 7 jours).

model TicketQuota {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  date      String   // format YYYY-MM-DD
  count     Int      @default(0)
  updatedAt DateTime @updatedAt

  @@unique([userId, date])
  @@map("ticket_quotas")
}

// ─── DÉPENSES (SORTIES) ───────────────────────────────────────────────────────

model Expense {
  id          String   @id @default(uuid())
  amount      Int
  description String
  category    String   @default("other") // hosting, domain, api, marketing, salary, other
  date        DateTime @default(now())
  createdAt   DateTime @default(now())

  @@map("expenses")
}

// ─── BET TRACKER ──────────────────────────────────────────────────────────────

model BetEntry {
  id         String    @id @default(uuid())
  userId     String
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  matchId    String?
  match      Match?    @relation(fields: [matchId], references: [id])
  teamA      String
  teamB      String
  prediction String    // HOME_WIN, AWAY_WIN, DRAW, OVER_2_5, etc.
  odds       Float
  stake      Int       // mise en FCFA
  result     String?   // WIN | LOSS | VOID | null (en attente)
  matchDate  DateTime
  notes      String?   @db.Text
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  @@index([userId])
  @@map("bet_entries")
}

// ─── RAPPELS MATCHS ───────────────────────────────────────────────────────────

model MatchReminder {
  id            String   @id @default(uuid())
  userId        String
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  matchId       String
  match         Match    @relation(fields: [matchId], references: [id])
  minutesBefore Int      @default(60) // 60 min avant
  sent          Boolean  @default(false)
  createdAt     DateTime @default(now())

  @@unique([userId, matchId])
  @@index([sent, matchId])
  @@map("match_reminders")
}

// ─── BLOG SEO ─────────────────────────────────────────────────────────────────

model BlogPost {
  id          String    @id @default(uuid())
  slug        String    @unique
  title       String
  content     String    @db.Text
  excerpt     String?
  coverImage  String?
  category    String    @default("general")
  published   Boolean   @default(false)
  publishedAt DateTime?
  metaTitle   String?
  metaDesc    String?
  views       Int       @default(0)
  authorId    String?
  author      User?     @relation("BlogAuthor", fields: [authorId], references: [id])
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([slug])
  @@index([published, publishedAt])
  @@map("blog_posts")
}

// ─── MONÉTISATION TIPSTERS ────────────────────────────────────────────────────

model TipsterPlan {
  id          String   @id @default(uuid())
  tipsterId   String   @unique
  tipster     User     @relation("TipsterPlan", fields: [tipsterId], references: [id], onDelete: Cascade)
  name        String   @default("Plan Premium")
  description String?
  price       Int      // FCFA/mois
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  subscriptions TipsterSubscription[]

  @@map("tipster_plans")
}

model TipsterSubscription {
  id           String    @id @default(uuid())
  subscriberId String
  subscriber   User      @relation("TipsterSubscriber", fields: [subscriberId], references: [id], onDelete: Cascade)
  planId       String
  plan         TipsterPlan @relation(fields: [planId], references: [id])
  status       SubStatus @default(ACTIVE)
  startDate    DateTime  @default(now())
  endDate      DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@unique([subscriberId, planId])
  @@index([subscriberId])
  @@map("tipster_subscriptions")
}

// ─── PUSH NOTIFICATIONS ───────────────────────────────────────────────────────

model PushSubscription {
  id        String   @id @default(uuid())
  endpoint  String   @unique
  p256dh    String
  auth      String
  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  createdAt DateTime @default(now())

  @@map("push_subscriptions")
}

// ─── COMBINÉS (MULTI-PICKS) ────────────────────────────────────────────────────

model TipCombo {
  id        String          @id @default(uuid())
  userId    String
  user      User            @relation("UserCombos", fields: [userId], references: [id], onDelete: Cascade)
  title     String?
  totalOdds Float           @default(1)
  isPremium Boolean         @default(false)
  result    String?         // WIN | LOSS | PENDING
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt
  entries   TipComboEntry[]

  @@index([userId])
  @@map("tip_combos")
}

model TipComboEntry {
  id         String   @id @default(uuid())
  comboId    String
  combo      TipCombo @relation(fields: [comboId], references: [id], onDelete: Cascade)
  matchId    String
  match      Match    @relation(fields: [matchId], references: [id])
  prediction String
  odds       Float
  result     String?  // WIN | LOSS | VOID | null
  createdAt  DateTime @default(now())

  @@index([comboId])
  @@map("tip_combo_entries")
}

// ─── FOLLOW TIPSTER (GRATUIT) ─────────────────────────────────────────────────

model TipsterFollow {
  id         String   @id @default(uuid())
  followerId String
  follower   User     @relation("FollowerUser", fields: [followerId], references: [id], onDelete: Cascade)
  tipsterId  String
  tipster    User     @relation("FollowedUser", fields: [tipsterId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now())

  @@unique([followerId, tipsterId])
  @@index([tipsterId])
  @@map("tipster_follows")
}

// ─── COMMENTAIRES SUR LES PRONOSTICS ─────────────────────────────────────────

model TipComment {
  id        String   @id @default(uuid())
  tipId     String
  tip       Tip      @relation(fields: [tipId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation("TipCommentAuthor", fields: [userId], references: [id], onDelete: Cascade)
  content   String   @db.Text
  createdAt DateTime @default(now())

  @@index([tipId])
  @@map("tip_comments")
}

// ─── ANALYTICS INTERNES ───────────────────────────────────────────────────────

model EventLog {
  id        String   @id @default(uuid())
  userId    String?
  event     String   // tipster_view | tip_view | match_view | conversion | search
  entityId  String?
  metadata  Json?
  createdAt DateTime @default(now())

  @@index([event, createdAt])
  @@index([entityId])
  @@map("event_logs")
}

// ─── WALLET FICTIF (GAMIFICATION) ────────────────────────────────────────────

model VirtualWallet {
  id        String       @id @default(uuid())
  userId    String       @unique
  user      User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  balance   Int          @default(1000) // points fictifs
  totalWon  Int          @default(0)
  totalLost Int          @default(0)
  updatedAt DateTime     @updatedAt
  bets      VirtualBet[]

  @@map("virtual_wallets")
}

model VirtualBet {
  id         String        @id @default(uuid())
  walletId   String
  wallet     VirtualWallet @relation(fields: [walletId], references: [id], onDelete: Cascade)
  matchId    String
  match      Match         @relation(fields: [matchId], references: [id])
  prediction String
  odds       Float
  stake      Int
  payout     Int?          // calculé si WIN = stake * odds
  result     String?       // WIN | LOSS | VOID | null (en attente)
  createdAt  DateTime      @default(now())

  @@index([walletId])
  @@map("virtual_bets")
}

// ─── ALERTES COTES ───────────────────────────────────────────────────────────

model OddsAlert {
  id          String    @id @default(uuid())
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  teamName    String
  targetOdds  Float
  condition   String    @default("above") // above | below
  isActive    Boolean   @default(true)
  triggeredAt DateTime?
  createdAt   DateTime  @default(now())

  @@index([isActive])
  @@index([userId])
  @@map("odds_alerts")
}

// ─── HISTORIQUE HEBDO TIPSTER ─────────────────────────────────────────────────

model TipsterWeeklyStats {
  id          String   @id @default(uuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  weekStart   DateTime
  tips        Int      @default(0)
  correct     Int      @default(0)
  successRate Float    @default(0)
  roi         Float    @default(0)
  createdAt   DateTime @default(now())

  @@unique([userId, weekStart])
  @@index([userId])
  @@map("tipster_weekly_stats")
}

// ─── SUPPORT HUMAIN ───────────────────────────────────────────────────────────

model SupportTicket {
  id        String          @id @default(uuid())
  userId    String?
  user      User?           @relation(fields: [userId], references: [id], onDelete: SetNull)
  email     String
  subject   String
  status    SupportStatus   @default(OPEN)
  messages  SupportMessage[]
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt

  @@index([status])
  @@index([userId])
  @@map("support_tickets")
}

model SupportMessage {
  id        String        @id @default(uuid())
  ticketId  String
  ticket    SupportTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  isAdmin   Boolean       @default(false)
  content   String        @db.Text
  createdAt DateTime      @default(now())

  @@index([ticketId])
  @@map("support_messages")
}

enum SupportStatus {
  OPEN
  IN_PROGRESS
  RESOLVED
  CLOSED
}
